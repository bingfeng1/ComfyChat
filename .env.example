# ComfyUI
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
COMFYUI_USERDATA_DIR=

# Backend
DATABASE_URL=sqlite:///./storage/data/comfychat.db
STORAGE_ROOT=./storage

